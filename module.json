{
  "id": "mist",
  "name": "(MIST)",
  "abbrev": "MS",
  "version": "0.3.0",
  "description": "Granular feedback processor \u2014 grains re-play recent audio with a tight, adaptive feedback loop; pre/post blend morphs a dry cloud into a spatial delay",
