{
  "id": "mist",
  "name": "(MIST)",
  "abbrev": "MS",
  "version": "0.6.0",
  "description": "Granular feedback processor \u2014 grains re-play recent audio with a tight, adaptive feedback loop; pre/post blend morphs a dry cloud into a spatial delay",
  "author": "ABLENTON",
  "license": "MIT",
  "dsp": "mist.so",
  "api_version": 2,
  "capabilities": {
    "audio_in": true,
    "audio_out": true,
    "chainable": true,
    "component_type": "audio_fx",
    "ui_hierarchy": {
      "levels": {
        "root": {
          "name": "MIST",
          "params": [
            {
              "key": "scope",
              "label": "Scope",
              "type": "canvas",
              "canvas_script": "canvas.js",
              "extra_keys": [
                "viz"
              ],
              "fullscreen_live_ms": 50
            },
            {
              "key": "size",
              "label": "Size",
              "type": "int",
              "min": 8,
              "max": 500,
              "default": 220,
              "step": 1,
              "unit": "ms"
            },
            {
              "key": "amount",
              "label": "Amount",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.6,
              "step": 0.01,
              "unit": "%",
              "viz": {
                "group": "win",
                "role": "amount",
                "kind": "custom:mist_window"
              }
            },
            {
              "key": "spike",
              "label": "Spike",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.5,
              "step": 0.01,
              "unit": "%",
              "viz": {
                "group": "win",
                "role": "spike",
                "kind": "custom:mist_window"
              }
            },
            {
              "key": "blur",
              "label": "Blur",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.15,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "pitch",
              "label": "Pitch",
              "type": "float",
              "min": -36.0,
              "max": 36.0,
              "default": -12.0,
              "step": 0.1,
              "unit": "st"
            },
            {
              "key": "fb_pre",
              "short_name": "FBpre",
              "label": "FB Pre",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.0,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "fb_post",
              "short_name": "FBpost",
              "label": "FB Post",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.45,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "mix",
              "label": "Mix",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.5,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "density",
              "label": "Density",
              "type": "float",
              "min": 1.0,
              "max": 200.0,
              "default": 22.0,
              "step": 0.5,
              "unit": "/s"
            },
            {
              "key": "spread",
              "label": "Spread",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.7,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "scatter",
              "label": "Scatter",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.0,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "width",
              "label": "Width",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.6,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "vol",
              "label": "Vol",
              "type": "float",
              "min": 0.0,
              "max": 1.5,
              "default": 0.9,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "in_gain",
              "label": "In Gain",
              "type": "float",
              "min": -12.0,
              "max": 24.0,
              "default": 0.0,
              "step": 0.5,
              "unit": "dB"
            },
            {
              "key": "fb_time",
              "label": "FB Time",
              "type": "int",
              "min": 0,
              "max": 2000,
              "default": 0,
              "step": 1,
              "unit": "ms"
            },
            {
              "key": "freeze",
              "label": "Freeze",
              "type": "enum",
              "options": [
                "off",
                "on"
              ],
              "default": 0
            },
            {
              "key": "reverse",
              "label": "Reverse",
              "type": "enum",
              "options": [
                "off",
                "on"
              ],
              "default": 0
            },
            {
              "level": "rhythm",
              "label": "Rhythm"
            },
            {
              "level": "trigger",
              "label": "Trigger"
            },
            {
              "level": "trig_map",
              "label": "Trigger Map"
            }
          ],
          "knobs": [
            "size",
            "amount",
            "spike",
            "blur",
            "pitch",
            "fb_pre",
            "fb_post",
            "mix"
          ]
        },
        "trigger": {
          "label": "Trigger",
          "knobs": [
            "trg_thresh",
            "trg_return",
            "trg_scale"
          ],
          "params": [
            {
              "key": "trg_thresh",
              "short_name": "Thresh",
              "label": "Thresh",
              "type": "float",
              "min": -60.0,
              "max": 0.0,
              "default": -24.0,
              "step": 0.5,
              "unit": "dB"
            },
            {
              "key": "trg_return",
              "short_name": "Return",
              "label": "Return",
              "type": "int",
              "min": 10,
              "max": 2000,
              "default": 300,
              "step": 1,
              "unit": "ms"
            },
            {
              "key": "trg_scale",
              "label": "Scale",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.5,
              "step": 0.01,
              "unit": "%",
              "short_name": "Scale"
            }
          ]
        },
        "trig_map": {
          "label": "Trigger Map",
          "knobs": [
            "trg1_dest",
            "trg1_min",
            "trg1_max",
            null,
            "trg2_dest",
            "trg2_min",
            "trg2_max",
            null
          ],
          "params": [
            {
              "key": "trg1_dest",
              "short_name": "T1 Dst",
              "label": "T1 Dest",
              "type": "enum",
              "options": [
                "Off",
                "Size",
                "Amount",
                "Spike",
                "Blur",
                "Pitch",
                "FB Pre",
                "FB Post",
                "Mix",
                "Width",
                "Vol",
                "Density",
                "Spread",
                "Scatter"
              ],
              "default": 7,
              "viz": {
                "group": "t1",
                "role": "dest",
                "span": false,
                "kind": "custom:mist_range"
              }
            },
            {
              "key": "trg1_min",
              "label": "T1 Min",
              "type": "float",
              "min": -1.0,
              "max": 1.0,
              "default": 0.0,
              "step": 0.01,
              "unit": "%",
              "short_name": "T1 Min",
              "viz": {
                "group": "t1",
                "role": "min",
                "kind": "custom:mist_range",
                "extra_keys": [
                  "trg_env"
                ]
              }
            },
            {
              "key": "trg1_max",
              "label": "T1 Max",
              "type": "float",
              "min": -1.0,
              "max": 1.0,
              "default": 0.35,
              "step": 0.01,
              "unit": "%",
              "short_name": "T1 Max",
              "viz": {
                "group": "t1",
                "role": "max",
                "kind": "custom:mist_range"
              }
            },
            {
              "key": "trg2_dest",
              "short_name": "T2 Dst",
              "label": "T2 Dest",
              "type": "enum",
              "options": [
                "Off",
                "Size",
                "Amount",
                "Spike",
                "Blur",
                "Pitch",
                "FB Pre",
                "FB Post",
                "Mix",
                "Width",
                "Vol",
                "Density",
                "Spread",
                "Scatter"
              ],
              "default": 0,
              "viz": {
                "group": "t2",
                "role": "dest",
                "span": false,
                "kind": "custom:mist_range"
              }
            },
            {
              "key": "trg2_min",
              "label": "T2 Min",
              "type": "float",
              "min": -1.0,
              "max": 1.0,
              "default": 0.0,
              "step": 0.01,
              "unit": "%",
              "short_name": "T2 Min",
              "viz": {
                "group": "t2",
                "role": "min",
                "kind": "custom:mist_range",
                "extra_keys": [
                  "trg_env"
                ]
              }
            },
            {
              "key": "trg2_max",
              "label": "T2 Max",
              "type": "float",
              "min": -1.0,
              "max": 1.0,
              "default": -0.3,
              "step": 0.01,
              "unit": "%",
              "short_name": "T2 Max",
              "viz": {
                "group": "t2",
                "role": "max",
                "kind": "custom:mist_range"
              }
            }
          ]
        },
        "rhythm": {
          "label": "Rhythm",
          "knobs": [
            "gmode",
            "density",
            "eu_pattern",
            "eu_rate",
            "eu_rot",
            "eu_burst",
            "eu_jitter",
            "spread"
          ],
          "params": [
            {
              "key": "gmode",
              "label": "Mode",
              "type": "enum",
              "options": [
                "Free",
                "Euclid"
              ],
              "default": 0,
              "viz": {
                "group": "eu",
                "role": "mode",
                "span": false,
                "kind": "custom:mist_euclid"
              }
            },
            {
              "key": "density",
              "label": "Density",
              "type": "float",
              "min": 1.0,
              "max": 200.0,
              "default": 22.0,
              "step": 0.5,
              "unit": "/s"
            },
            {
              "key": "eu_pattern",
              "short_name": "Pattern",
              "label": "Pattern",
              "type": "enum",
              "options": [
                "5/8 Cinquillo",
                "3/8 Tresillo",
                "2/5",
                "3/4",
                "3/7",
                "4/7",
                "4/9",
                "5/9",
                "5/11",
                "5/12",
                "5/16 Bossa",
                "7/12",
                "7/16",
                "9/16",
                "11/16",
                "13/16",
                "Every step"
              ],
              "default": 0,
              "viz": {
                "group": "eu",
                "role": "pattern",
                "kind": "custom:mist_euclid",
                "extra_keys": [
                  "eu_pos"
                ]
              }
            },
            {
              "key": "eu_rate",
              "label": "Rate",
              "type": "enum",
              "options": [
                "1/32",
                "1/16T",
                "1/16",
                "1/8T",
                "1/8",
                "1/4"
              ],
              "default": 2,
              "viz": {
                "group": "eu",
                "role": "rate",
                "kind": "custom:mist_euclid"
              }
            },
            {
              "key": "eu_rot",
              "short_name": "Rotate",
              "label": "Rotate",
              "type": "int",
              "min": 0,
              "max": 15,
              "default": 0,
              "step": 1,
              "viz": {
                "group": "eu",
                "role": "rot",
                "span": false,
                "kind": "custom:mist_euclid"
              }
            },
            {
              "key": "eu_burst",
              "label": "Burst",
              "type": "int",
              "min": 1,
              "max": 8,
              "default": 1,
              "step": 1
            },
            {
              "key": "eu_jitter",
              "short_name": "Jitter",
              "label": "Jitter",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.05,
              "step": 0.01,
              "unit": "%"
            },
            {
              "key": "spread",
              "label": "Spread",
              "type": "float",
              "min": 0.0,
              "max": 1.0,
              "default": 0.7,
              "step": 0.01,
              "unit": "%"
            }
